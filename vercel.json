{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/plans",
      "destination": "/care-plans",
      "permanent": false
    },
    {
      "source": "/plans/",
      "destination": "/care-plans",
      "permanent": false
    },
    {
      "source": "/apps",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apps/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/thank-you/",
      "destination": "/thank-you.html"
    },
    {
      "source": "/websites",
      "destination": "/websites/index.html"
    },
    {
      "source": "/websites/",
      "destination": "/websites/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/",
      "destination": "/work/index.html"
    },
    {
      "source": "/care-plans",
      "destination": "/care-plans/index.html"
    },
    {
      "source": "/care-plans/",
      "destination": "/care-plans/index.html"
    },
    {
      "source": "/ai-services",
      "destination": "/ai-services/index.html"
    },
    {
      "source": "/ai-services/",
      "destination": "/ai-services/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact/index.html"
    },
    {
      "source": "/tech-help",
      "destination": "/tech-help/index.html"
    },
    {
      "source": "/tech-help/",
      "destination": "/tech-help/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/post.html"
    },
    {
      "source": "/examples/castos-auto-repair",
      "destination": "/examples/castos-auto-repair/index.html"
    },
    {
      "source": "/examples/castos-auto-repair/",
      "destination": "/examples/castos-auto-repair/index.html"
    },
    {
      "source": "/examples/riverside-lawn",
      "destination": "/examples/riverside-lawn/index.html"
    },
    {
      "source": "/examples/riverside-lawn/",
      "destination": "/examples/riverside-lawn/index.html"
    },
    {
      "source": "/examples/summit-comfort-hvac",
      "destination": "/examples/summit-comfort-hvac/index.html"
    },
    {
      "source": "/examples/summit-comfort-hvac/",
      "destination": "/examples/summit-comfort-hvac/index.html"
    },
    {
      "source": "/examples/heritage-home-partners",
      "destination": "/examples/heritage-home-partners/index.html"
    },
    {
      "source": "/examples/heritage-home-partners/",
      "destination": "/examples/heritage-home-partners/index.html"
    }
  ],
  "headers": [
    {
      "source": "/examples/castos-auto-repair/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.tailwindcss.com https://va.vercel-scripts.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.tailwindcss.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co https://va.vercel-scripts.com https://www.facebook.com https://connect.facebook.net; form-action 'self' https://formsubmit.co; frame-src 'self' https://www.google.com https://maps.google.com https://www.openstreetmap.org; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ]
}
