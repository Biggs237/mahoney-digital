# Casto's unlisted demo — HTTP Basic Auth (Vercel Edge Middleware)
# Set these in Vercel → Project → Settings → Environment Variables
CASTOS_DEMO_USER=castos
CASTOS_DEMO_PASSWORD=

# Site chat widget (api/chat.js) — SpaceXAI / xAI
# Create a key at https://console.x.ai — never commit the real key
XAI_API_KEY=
# Optional model override (default: grok-4.5)
# XAI_CHAT_MODEL=grok-4.5