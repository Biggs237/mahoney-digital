# Copy to .env and fill in (never commit .env)
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your Telegram user ID (message @userinfobot to get it)
TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id

# Substack (unofficial API — optional, for /substack bot commands)
SUBSTACK_PUBLICATION_URL=https://yourname.substack.com
SUBSTACK_EMAIL=your_substack_login_email
SUBSTACK_PASSWORD=your_substack_password
# Or cookie auth instead of email/password (export from browser while logged in):
# SUBSTACK_COOKIES_PATH=tools/.substack_cookies.json